{
  "name": "LeetHub",
  "version": "2.0.9",
  "private": true,
  "description": "Automatically syncs your solved problems to GitHub",
  "type": "module",
  "scripts": {
    "dev": "webpack --mode=production --watch",
    "setup": "pnpm install && cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "format": "prettier --write **/*.{js,jsx,ts,tsx,css,html}",
    "format-test": "prettier --check **/*.{js,jsx,ts,tsx,css,html}",
    "lint": "eslint . --fix",
    "lint-test": "eslint . --color",
    "build": "webpack --mode=production",
    "test": "node --import ./scripts/dev/register-ts-loader.mjs node_modules/jasmine/bin/jasmine.js",
    "check-leaks": "node scripts/dev/check-leaks.mjs"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/jquery": "^4.0.1",
    "chrome-types": "^0.1.282",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.9.0",
    "filemanager-webpack-plugin": "^8.0.0",
    "ignore-loader": "^0.1.2",
    "jasmine": "^5.1.0",
    "prettier": "^2.2.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "webpack": "^5.92.0",
    "webpack-cli": "^5.1.4"
  }
}
