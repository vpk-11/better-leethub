{
  "manifest_version": 3,
  "name": "LeetHub",
  "description": "Automatically integrate your LeetCode submissions to GitHub",
  "homepage_url": "https://github.com/vpk-11/LeetHub",
  "version": "__LH_VERSION__",
  "action": {
    "default_icon": "assets/thumbnail.png",
    "default_popup": "popup.html",
    "default_title": "Upload your LeetCode solutions to GitHub"
  },
  "icons": {
    "16": "assets/thumbnail.png",
    "48": "assets/thumbnail.png",
    "128": "assets/thumbnail.png"
  },
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "permissions": ["unlimitedStorage", "storage"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/interceptorLoader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/leetcode.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/interceptor.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "leethub@vpk.com",
      "strict_min_version": "109.0"
    }
  }
}
