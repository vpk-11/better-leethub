{
  "manifest_version": 3,
  "name": "Better LeetHub",
  "description": "Automatically syncs your solved problems to GitHub",
  "homepage_url": "https://github.com/vpk-11/better-leethub",
  "version": "__LH_VERSION__",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Upload your LeetCode solutions to GitHub"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "background": {
    "scripts": ["scripts/background.js"]
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/interceptorLoader.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["scripts/leetcode.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/interceptor.js"],
      "matches": ["https://leetcode.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{fcc577f0-adb7-4cbe-bf6a-bd0b8ceae19c}",
      "strict_min_version": "109.0"
    }
  }
}
